<script>
document.addEventListener("DOMContentLoaded", function () {
  const hero = document.querySelector(".exact-printent-hero");
  const second = document.querySelector(".hero-second-slide");

  if (!hero || !second) return;

  let autoSlide = 1;

  setInterval(function () {
    autoSlide = autoSlide === 1 ? 2 : 1;

    if (autoSlide === 2) {
      second.classList.add("is-active");
      second.setAttribute("aria-hidden", "false");
    } else {
      second.classList.remove("is-active");
      second.setAttribute("aria-hidden", "true");
    }
  }, 5000); // 5000 = 5 seconds
});
</script>


<style id="hero-arrow-final-fix">

/* Hero itself is the positioning boundary */
.exact-printent-hero{
  position: relative !important;
  overflow: hidden !important;
}

/* BOTH ARROWS — reference style */
.exact-slider-arrow{
  position: absolute !important;
  top: 50% !important;
  transform: translateY(-50%) !important;

  width: 55px !important;
  height: 80px !important;

  padding: 0 !important;
  margin: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  color: white !important;

  font-family: Arial, sans-serif !important;
  font-size: 0 !important;

  cursor: pointer !important;

  z-index: 999 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  opacity: 1 !important;
  visibility: visible !important;
}

/* LEFT */
.exact-slider-left{
  left: 20px !important;
}

/* RIGHT */
.exact-slider-right{
  right: 20px !important;
}

/* Make exact < > looking arrows */
.exact-slider-left::before,
.exact-slider-right::before{
  content: "" !important;

  width: 21px !important;
  height: 21px !important;

  display: block !important;

  border-top: 3px solid #fff !important;
  border-right: 3px solid #fff !important;
}

.exact-slider-left::before{
  transform: rotate(-135deg) !important;
}

.exact-slider-right::before{
  transform: rotate(45deg) !important;
}

/* no weird hover box */
.exact-slider-arrow:hover{
  background: transparent !important;
  opacity: .8 !important;
}

/* mobile */
@media(max-width: 700px){

  .exact-slider-left{
    left: 8px !important;
  }

  .exact-slider-right{
    right: 8px !important;
  }

  .exact-slider-left::before,
  .exact-slider-right::before{
    width: 17px !important;
    height: 17px !important;
  }
}

</style>


<style id="hero-arrow-only-angle">

.exact-printent-hero{
  position: relative !important;
  overflow: hidden !important;
}

/* ONLY < and > */
