<style id="ABSOLUTE-FINAL-SINGLE-ARROW-FIX">

/* KILL ALL EXTRA GENERATED ARROWS */
.exact-printent-hero .exact-slider-arrow::before,
.exact-printent-hero .exact-slider-arrow::after,
.exact-printent-hero .exact-slider-left::before,
