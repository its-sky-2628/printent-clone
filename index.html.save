<style id="second-hero-exact-css">

/* =========================================================
   PRINTENT SECOND HERO — DIGITAL PRINTING
   ========================================================= */

.exact-printent-hero{
  position:relative;
  overflow:hidden;
}

/* second slide fills exact hero */
.hero-second-slide{
  position:absolute;
  inset:0;
  z-index:20;
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .65s ease, visibility .65s ease;
  overflow:hidden;
  background:#050303;
}

.hero-second-slide.is-active{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}


/* BACKGROUND */

.hero-second-bg{
  position:absolute;
  inset:0;

  background-image:url("assets/images/hero-slide-2.jpg");
  background-repeat:no-repeat;

  /*
    Reference:
    women stay on right,
    machine remains behind left text.
  */
  background-size:cover;
  background-position:center center center;

  z-index:0;
}


/* DARK LEFT OVERLAY */

.hero-second-shade{
  position:absolute;
  inset:0;
  z-index:1;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.82) 0%,
      rgba(0,0,0,.70) 24%,
      rgba(0,0,0,.42) 43%,
      rgba(0,0,0,.10) 65%,
      rgba(0,0,0,0) 82%
    );
}


/* MAIN CONTENT */

.hero-second-content{
  position:absolute;
  z-index:3;

  left:14.5%;
  top: 53%;

  transform:translateY(-43%);

  width:720px;
}


/* Produce the */

.hero-second-small{
  margin:0 0 4px 0;

  font-family:"Lora", Georgia, serif;
  font-size:68px;
  line-height:1.05;
  font-weight:400;

  color:#fff;
  white-space:nowrap;
}


/* Digital printing */

.hero-second-big{
  font-family:"Lora", Georgia, serif;

  font-size:112px;
  line-height:1.12;
  font-weight:400;

  white-space:nowrap;

  background:linear-gradient(
    90deg,
    #ff922f 0%,
    #ff8141 38%,
    #ff6860 76%,
    #ff5e69 100%
  );

  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  color:transparent;
}


/* BOTTOM ROW */

.hero-second-bottom{
  display:flex;
  align-items:center;

  margin-top:52px;

  height:104px;
}


/* paragraph */

.hero-second-description{
  margin-top:-30px;
  width:440px;

  font-family:Arial, Helvetica, sans-serif;

  font-size:17px;
  line-height:1.65;
  font-weight:400;

  color:#fff;
}


/* divider */

.hero-second-divider{
  width:1px;
  height:102px;

  margin-left:26px;
  margin-right:42px;

  background:rgba(255,255,255,.42);

  flex:none;
}


/* More Services button */

.hero-second-button{
  display:flex;
  align-items:center;
  justify-content:center;

  min-width:174px;
  height:51px;

  padding:0 30px;

  border-radius:40px;

  background:linear-gradient(
    90deg,
    #ff962e,
    #ff5f68
  );

  color:#fff !important;

  font-family:Georgia, "Times New Roman", serif;
  font-size:16px;
  font-weight:600;

  text-decoration:none !important;

  white-space:nowrap;

  transition:transform .2s ease;
}

.hero-second-button:hover{
  transform:translateY(-2px);
}


/* arrows must stay above both slides */

.exact-slider-arrow{
  z-index:100 !important;
}


/* ---------------------------------------------------------
   LARGE DESKTOP
--------------------------------------------------------- */

@media (min-width:1500px){

  .hero-second-content{
    left:14.5%;
    width:850px;
  }

  .hero-second-small{
    font-size:68px;
  }

  .hero-second-big{
    font-size:112px;
  }

}


/* ---------------------------------------------------------
   LAPTOP
--------------------------------------------------------- */

@media (max-width:1300px){

  .hero-second-content{
    left:11%;
    width:700px;
  }

  .hero-second-small{
    font-size:58px;
  }

  .hero-second-big{
    font-size:82px;
  }

  .hero-second-description{
  margin-top:-30px;
    width:370px;
    font-size:15px;
  }

}


/* ---------------------------------------------------------
   TABLET / ORIGINAL RESPONSIVE FEEL
--------------------------------------------------------- */

@media (max-width:900px){

  .hero-second-bg{
    background-position:58% center;
  }

  .hero-second-shade{
    background:
      linear-gradient(
        90deg,
        rgba(0,0,0,.78),
        rgba(0,0,0,.30)
      );
  }

  .hero-second-content{
    left:14%;
    top:48%;
    width:72%;
    transform:translateY(-45%);
  }

  .hero-second-small{
    font-size:48px;
  }

  .hero-second-big{
    font-size:70px;
  }

  .hero-second-bottom{
    margin-top:32px;
  }

  .hero-second-description{
  margin-top:-30px;
    display:none;
  }

  .hero-second-divider{
    display:none;
  }

  .hero-second-button{
    height:48px;
    min-width:160px;
  }

}


/* ---------------------------------------------------------
   MOBILE
--------------------------------------------------------- */

@media (max-width:600px){

  .hero-second-bg{
    background-position:62% center;
  }

  .hero-second-content{
    left:14%;
    top:47%;
    width:82%;
  }

  .hero-second-small{
    font-size:39px;
  }

  .hero-second-big{
    font-size:53px;
    line-height:0.92;
  }

  .hero-second-bottom{
    margin-top:28px;
    height:auto;
  }

  .hero-second-button{
    min-width:150px;
    height:47px;
    font-size:15px;
  }

}

</style>


<style id="FINAL-ONLY-HERO-ARROWS">

.exact-printent-hero{
    position:relative !important;
}

/* remove EVERY generated arrow */
.exact-slider-arrow::before,
.exact-slider-arrow::after{
    content:none !important;
    display:none !important;
}

/* actual button itself */
.exact-slider-arrow{
    position:absolute !important;
    top:50% !important;
    transform:translateY(-50%) !important;

    display:flex !important;
    align-items:center !important;
    justify-content:center !important;

    width:55px !important;
    height:80px !important;

    padding:0 !important;
    margin:0 !important;

    background:transparent !important;
    border:0 !important;
    outline:0 !important;
    box-shadow:none !important;

    color:white !important;

    font-family:Arial, Helvetica, sans-serif !important;
    font-size:52px !important;
    font-weight:200 !important;
    line-height:1 !important;

    opacity:1 !important;
    visibility:visible !important;

    cursor:pointer !important;
    z-index:99999 !important;
}

.exact-slider-left{
    left:18px !important;
}

.exact-slider-right{
    left:auto !important;
    right:18px !important;
}

.exact-slider-arrow:hover,
.exact-slider-arrow:focus,
.exact-slider-arrow:active{
    background:transparent !important;
    border:0 !important;
    box-shadow:none !important;
    opacity:1 !important;
}

</style>

</head>

